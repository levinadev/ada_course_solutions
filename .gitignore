# Object file
*.o

# Ada Library Information
*.ali

# В папках задач хранятся только исходники Ada, всё остальное появляется при сборке.
# Это программа без расширения (Linux, macOS) или .exe (Windows), файлы .o и .ali
/*/**/*
!/*/**/
!/*/**/*.adb
!/*/**/*.ads
*.exe

# Временные файлы GNAT (b~имя.adb), они тоже .adb, поэтому исключаются после правила выше
b~*

# Папки, которые создаёт Alire, если собирать через него
alire/
obj/
bin/
config/

# Настройки редактора
.idea/
.vscode/
